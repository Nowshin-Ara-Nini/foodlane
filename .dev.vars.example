# Copy to .dev.vars for loopback development. Never commit real secrets.
AUTH_BASE_URL=http://localhost:5173
AUTH_ALLOW_LOCAL_HTTP=true
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RESEND_API_KEY=
AUTH_EMAIL_FROM=Foodlane <accounts@your-verified-domain.example>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a local-only key with: node scripts/configure-private-local.mjs
# Store the production JSON key ring using wrangler secret put NID_ENCRYPTION_KEYS.
# NID_ENCRYPTION_KEYS='{"v1":"BASE64_OF_32_RANDOM_BYTES"}'
NID_KEY_VERSION=v1
VERIFICATION_RETENTION_ENABLED=true
VERIFICATION_RETENTION_DAYS=30
