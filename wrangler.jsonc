{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foodlane",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Deliberately not publicly routable during the six implementation checkpoints.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "foodlane",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "foodlane-media" }],
  "vars": {
    "AUTH_BASE_URL": "https://foodlane.invalid",
    "AUTH_ALLOW_LOCAL_HTTP": "false"
  }
}
